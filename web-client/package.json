{
  "name": "web-client",
  "private": true,
  "version": "0.1.0",
  "build": 1,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --outDir ../client-build --emptyOutDir",
    "prebuild": "node scripts/write-version.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "test": "vitest run",
    "generate-mtproto-types": "node scripts/generate_mtproto_types.mjs src/",
    "generate-tl-schema": "node scripts/generate_tl_schema.mjs",
    "check-layer-types": "tsc -p scripts/tsconfig.layer-check.json --noEmit",
    "generate-tgs-thumbnails": "node scripts/generate-tgs-thumbnails.mjs",
    "crosscheck": "vitest run --config scripts/crosscheck/vitest.config.ts"
  },
  "dependencies": {
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/fugaz-one": "^5.3.0",
    "@fontsource/playwrite-be-vlg": "^5.3.0",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/rubik-bubbles": "^5.3.0",
    "@fontsource/sedan": "^5.3.0",
    "@fontsource/suez-one": "^5.3.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@solid-primitives/refs": "^1.1.4",
    "@solid-primitives/transition-group": "^1.1.2",
    "big-integer": "^1.6.52",
    "leaflet": "^1.9.4",
    "mediabunny": "^1.51.0",
    "prismjs": "^1.30.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "solid-js": "^1.9.15",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sass": "^1.101.0",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
